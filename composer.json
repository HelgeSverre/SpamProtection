{
  "name": "helgesverre/spamprotection",
  "description": "A Spam Protection class for use in contact forms and comment fields, uses the StopForumSpam API.  ",
  "type": "library",
  "keywords": [
    "spam",
    "anti-spam",
    "protection",
    "stopforumspam",
    "api"
  ],
  "homepage": "https://helgesverre.com/products/spamprotection",
  "time": "2015-10-23",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "authors": [
    {
      "name": "Helge Sverre",
      "email": "email@helgesverre.com",
      "homepage": "https://helgesverre.com",
      "role": "Developer"
    }
  ],
  "support": {
    "email": "email@helgesverre.com",
    "issues": "https://github.com/HelgeSverre/SpamProtection/issues",
    "source": "https://github.com/HelgeSverre/SpamProtection"
  },
  "autoload": {
    "psr-4": {
      "Helge\\SpamProtection\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Helge\\SpamProtection\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "pestphp/pest": "^2.0",
    "phpstan/phpstan": "^1.10",
    "friendsofphp/php-cs-fixer": "^3.0"
  },
  "scripts": {
    "test": "vendor/bin/pest",
    "test:coverage": "vendor/bin/pest --coverage --coverage-html=coverage",
    "test:unit": "vendor/bin/pest --exclude-group=integration",
    "test:integration": "vendor/bin/pest --group=integration",
    "phpstan": "vendor/bin/phpstan analyse src tests --level=8",
    "phpstan:baseline": "vendor/bin/phpstan analyse src tests --level=8 --generate-baseline",
    "cs-fix": "vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.php",
    "cs-check": "vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.php --dry-run --diff",
    "format": "@cs-fix",
    "lint": "@cs-check",
    "qa": [
      "@cs-check",
      "@phpstan",
      "@test"
    ],
    "qa:fix": [
      "@cs-fix",
      "@phpstan",
      "@test"
    ]
  },
  "scripts-descriptions": {
    "test": "Run all Pest tests",
    "test:coverage": "Run Pest tests with code coverage report",
    "test:unit": "Run unit tests only (excludes integration tests)",
    "test:integration": "Run integration tests only",
    "phpstan": "Run static analysis with PHPStan",
    "phpstan:baseline": "Generate PHPStan baseline file",
    "cs-fix": "Fix code style issues automatically",
    "cs-check": "Check for code style issues without fixing",
    "format": "Alias for cs-fix - format code",
    "lint": "Alias for cs-check - check code style",
    "qa": "Run all quality assurance checks (lint, static analysis, tests)",
    "qa:fix": "Run QA with automatic fixes where possible"
  },
  "minimum-stability": "stable",
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
